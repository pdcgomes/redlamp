#!/usr/bin/env bash
# Checks what a push puts on main as CI would, in a worktree of its own, and stops the push if it
# fails (scripts/push-gate.py). Pushes to other branches and tags go straight through. Skip it
# once with `git push --no-verify`.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
exec scripts/push-gate.py --hook "$@"
