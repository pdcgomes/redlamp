{
  "name": "redlamp-video",
  "version": "0.1.0",
  "private": true,
  "description": "Redlamp's animated explainer, built with Remotion and rendered to MP4.",
  "scripts": {
    "sync-assets": "node ../web/scripts/sync-assets.mjs",
    "prestudio": "npm run sync-assets",
    "studio": "remotion studio src/index.ts",
    "prerender": "npm run sync-assets",
    "render": "node scripts/render.mjs",
    "prestills": "npm run sync-assets",
    "stills": "node scripts/stills.mjs",
    "film-assets": "node scripts/film-assets.mjs",
    "preintroducing": "npm run sync-assets",
    "introducing": "node scripts/introducing.mjs",
    "prewelcome": "npm run sync-assets",
    "welcome": "node scripts/welcome.mjs",
    "prestar": "npm run sync-assets",
    "star": "node scripts/star.mjs",
    "star-score": "python3 scripts/star-score.py",
    "pixelkit": "node scripts/pixelkit.mjs",
    "pixelkit-frames": "python3 scripts/pixelkit-frames.py --hooks",
    "pixelkit-score": "python3 scripts/pixelkit-score.py",
    "prefeatures": "npm run sync-assets",
    "features": "node scripts/features.mjs",
    "features-frames": "python3 scripts/features-frames.py",
    "features-score": "python3 scripts/features-score.py",
    "review": "node scripts/review.mjs",
    "storyboard": "node scripts/storyboard.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/noise": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
