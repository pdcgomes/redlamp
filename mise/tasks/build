#!/usr/bin/env bash
#MISE description="Build the Redlamp macOS app"
#MISE alias="b"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

WORKSPACE="Redlamp.xcworkspace"
SCHEME="${SCHEME:-Redlamp}"
CONFIGURATION="${CONFIGURATION:-Debug}"

if [ ! -d "$WORKSPACE" ]; then
    echo "==> Workspace missing; generating first..."
    mise run generate
fi

echo "==> Building ${SCHEME} (${CONFIGURATION})..."
xcodebuild build \
    -workspace "$WORKSPACE" \
    -scheme "$SCHEME" \
    -configuration "$CONFIGURATION" \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath build/DerivedData \
    -quiet
