#!/usr/bin/env bash
#MISE description="Build and launch the Redlamp macOS app"
#MISE alias="r"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

mise run build
APP_PATH="build/DerivedData/Build/Products/${CONFIGURATION:-Debug}/Redlamp.app"
echo "==> Launching ${APP_PATH}"
open "$APP_PATH" --args "$@"
