#!/usr/bin/env bash
#MISE description="Download CC0 sample raw files from raw.pixls.us into tests/fixtures/raw and tests/fixtures/cameras"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
mkdir -p tests/fixtures/raw
cd tests/fixtures/raw

# One body per sensor family: Sony Bayer, Fujifilm X-Trans, Canon CR3, Nikon NEF, Apple linear DNG,
# and a Google Pixel Bayer DNG with gain maps (lens shading) and a warp opcode.
FILES=(
    "Sony/ILCE-7M3/_DSC0009.ARW"
    "Fujifilm/X-T3/AFXT2720.RAF"
    "Canon/EOS%20R6/Canon_EOS_R6_RAW_ISO_100_nocrop_nodual.CR3"
    "Nikon/Z%206/DSC_0750.NEF"
    "Apple/iPhone%2012%20Pro/IMG_1361.DNG"
    "Google/Pixel%204a/PXL_20201121_100251397.dng"
)

for path in "${FILES[@]}"; do
    name="$(basename "$path")"
    if [[ -f "$name" ]]; then
        echo "==> $name (cached)"
        continue
    fi
    echo "==> $name"
    curl -sfL -o "$name" "https://raw.pixls.us/data/$path"
done

# The camera coverage set (tests/decode/samples.json): one sample per main maker and format, about 1.2 GB.
cd "$(git rev-parse --show-toplevel)"
python3 - <<'EOF'
import hashlib, json, os, subprocess, sys

def sha256(path):
    digest = hashlib.sha256()
    with open(path, "rb") as file:
        for block in iter(lambda: file.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()

manifest = json.load(open("tests/decode/samples.json"))
os.makedirs("tests/fixtures/cameras", exist_ok=True)
failed = 0
for sample in manifest["samples"]:
    path = os.path.join("tests/fixtures/cameras", sample["file"])
    if os.path.exists(path) and sha256(path) == sample["sha256"]:
        print(f"==> {sample['file']} (cached)")
        continue
    print(f"==> {sample['file']} ({sample['megabytes']} MB)")
    subprocess.run(["curl", "-sfL", "-o", path + ".part", sample["url"]], check=False)
    if os.path.exists(path + ".part") and sha256(path + ".part") == sample["sha256"]:
        os.replace(path + ".part", path)
    else:
        print(f"    checksum mismatch or download failed: {sample['url']}", file=sys.stderr)
        failed += 1
sys.exit(1 if failed else 0)
EOF
