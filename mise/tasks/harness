#!/usr/bin/env bash
#MISE description="Build and launch the UI component harness"
#MISE alias="h"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

WORKSPACE="Redlamp.xcworkspace"
[ -d "$WORKSPACE" ] || mise run generate

xcodebuild build \
    -workspace "$WORKSPACE" \
    -scheme RedlampHarness \
    -configuration "${CONFIGURATION:-Debug}" \
    -destination 'platform=macOS,arch=arm64' \
    -derivedDataPath build/DerivedData \
    -quiet

APP_PATH="build/DerivedData/Build/Products/${CONFIGURATION:-Debug}/RedlampHarness.app"
echo "==> Launching ${APP_PATH}"
open "$APP_PATH" --args "$@"
