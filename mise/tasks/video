#!/usr/bin/env bash
#MISE description="Open the explainer video (video/) in Remotion Studio; pass `render` to render the MP4s into video/out, `introducing [id…]` for the Introducing Redlamp film, `star [id…]` for the star promo, `features --episode=e01 [--hook=a] [--draft]` for a feature video, or `stills [id…]` for the Reddit stills"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)/video"

[ -d node_modules ] || npm ci

case "${1:-studio}" in
studio) npm run studio ;;
render) npm run render ;;
introducing)
    shift
    npm run introducing -- "$@"
    ;;
star)
    shift
    npm run star -- "$@"
    ;;
features)
    shift
    npm run features -- "$@"
    ;;
stills)
    shift
    npm run stills -- "$@"
    ;;
*)
    echo "usage: mise run video [-- studio|render|introducing [id…]|star [id…]|features --episode=<id> [--hook=<id>] [--draft]|stills [id…]]" >&2
    exit 1
    ;;
esac
