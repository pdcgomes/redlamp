#!/usr/bin/env bash
#MISE description="Download the CC0 look-development raw set (research/look-dev/manifest.json) into build/look-dev"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
mkdir -p build/look-dev

python3 - <<'EOF'
import hashlib, json, os, subprocess, sys

manifest = json.load(open("research/look-dev/manifest.json"))
failed = 0
for image in manifest["images"]:
    path = os.path.join("build/look-dev", image["file"])
    if os.path.exists(path) and hashlib.sha256(open(path, "rb").read()).hexdigest() == image["sha256"]:
        print(f"==> {image['file']} (cached)")
        continue
    print(f"==> {image['file']}")
    subprocess.run(["curl", "-sfL", "-o", path, image["url"]], check=False)
    if not os.path.exists(path) or hashlib.sha256(open(path, "rb").read()).hexdigest() != image["sha256"]:
        print(f"    checksum mismatch or download failed: {image['url']}", file=sys.stderr)
        failed += 1
print(f"{len(manifest['images']) - failed} of {len(manifest['images'])} images ready in build/look-dev")
sys.exit(1 if failed else 0)
EOF
