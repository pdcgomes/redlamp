#!/usr/bin/env bash
#MISE description="Build, sign, notarize and publish a GitHub release of Redlamp.app (with the redlamp CLI inside)"
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# DRY_RUN=1 builds and signs the app, its zip and its disk image without pushing a version bump,
# notarizing, tagging or publishing. With it, REF builds another commit, such as unpushed changes
# to this script. Without it, REF can name an earlier commit of main, to release it without what
# came after: its version bump is tagged rather than pushed, and main is given the same version so
# the next release moves on from it.
DRY_RUN="${DRY_RUN:-0}"
NOTARY_PROFILE="${REDLAMP_NOTARY_PROFILE:?REDLAMP_NOTARY_PROFILE is not set (run through mise)}"
TEAM_ID="${REDLAMP_TEAM_ID:?REDLAMP_TEAM_ID is not set (run through mise)}"
# Every installed copy checks this feed for updates (Info.plist's SUFeedURL). The site redirects
# it to the appcast.xml on the release marked Latest (web/next.config.ts).
FEED="https://redlamp.app/appcast.xml"

fail() {
    echo "error: $*" >&2
    exit 1
}

released() {
    git rev-parse -q --verify "refs/tags/v$1" >/dev/null || [ -n "$(git ls-remote --tags origin "refs/tags/v$1")" ]
}

# A release is origin/main, built in a clean worktree, so nothing uncommitted or untracked
# in this checkout can end up in it.
git fetch --quiet origin
COMMIT="$(git rev-parse "${REF:-origin/main}^{commit}")"
SOURCE="$COMMIT"
MAIN="$(git rev-parse origin/main)"
VERSION="$(git show "$COMMIT:Version.xcconfig" | sed -nE 's/^MARKETING_VERSION *= *([^ ]+).*/\1/p')"
# A version that's been released moves on to its next patch, 0.2.0-prealpha to 0.2.1-prealpha,
# committed to main before the build. Minor and major releases set MARKETING_VERSION by hand.
BUMP=0
if released "$VERSION"; then
    SEMVER='^([0-9]+)\.([0-9]+)\.([0-9]+)(-[0-9A-Za-z.-]+)?$'
    [[ "$VERSION" =~ $SEMVER ]] || fail "MARKETING_VERSION $VERSION isn't major.minor.patch, so it can't be bumped"
    VERSION="${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.$((BASH_REMATCH[3] + 1))${BASH_REMATCH[4]}"
    BUMP=1
fi
TAG="v$VERSION"
OUT="build/release"
PRODUCTS="$OUT/DerivedData/Build/Products/Release"
APP="$OUT/Redlamp.app"
ZIP="$OUT/Redlamp-$VERSION.zip"
DMG="$OUT/Redlamp-$VERSION.dmg"
DSYMS="$OUT/dSYMs"
# Not Redlamp-*.zip, which the site's download button takes for the app when a release has no disk
# image (web/lib/github.ts).
DSYMS_ZIP="$OUT/dSYMs-$VERSION.zip"

# The keychain can hold several Developer ID certificates with the same name, which
# codesign rejects as ambiguous, so sign by SHA-1, the black box's copy of the app included.
IDENTITY="${REDLAMP_SIGN_IDENTITY:-$(security find-identity -v -p codesigning \
    | awk -v team="($TEAM_ID)\"" '/"Developer ID Application:/ && index($0, team) { print $2; exit }')}"
[ -n "$IDENTITY" ] || fail "no Developer ID Application identity for team $TEAM_ID in the keychain"

# The firmware model's hosted files (TON-50): the config the owner keeps outside the repository
# gives the build both addresses and the masked secret its inner key needs, so no release ships
# without them. SKIP_FIRMWARE_MODEL="<why>" builds without them, and the reason goes in the log;
# the toggle then has no hosted model.
FIRMWARE_CONFIG="${REDLAMP_FIRMWARE_CONFIG:-$HOME/.config/redlamp/Firmware.local.xcconfig}"
if [ -z "${SKIP_FIRMWARE_MODEL:-}" ] && [ ! -f "$FIRMWARE_CONFIG" ] \
    && git cat-file -e "$COMMIT:scripts/firmware-release-config.py" 2>/dev/null; then
    fail "no firmware model config at $FIRMWARE_CONFIG (TON-50): the file redlamp recipe firmware-pack
       wrote, with both addresses filled in. Set REDLAMP_FIRMWARE_CONFIG to keep it elsewhere, or
       SKIP_FIRMWARE_MODEL=\"<why>\" to release without the hosted model"
fi

# A process started by a binary carrying com.apple.provenance tags every file it writes, and Homebrew
# installs mise with one. The zip leaves the tags out, but the disk image would hold them, and an app
# dragged from it to /Applications is then refused by Gatekeeper (#333).
if [ -z "${SKIP_DMG:-}" ]; then
    PROBE="$(mktemp)"
    echo probe >"$PROBE"
    PROBE_ATTRIBUTES="$(xattr "$PROBE" 2>/dev/null || true)"
    rm -f "$PROBE"
    if [[ "$PROBE_ATTRIBUTES" == *com.apple.provenance* ]]; then
        fail "the files this release writes are tagged with com.apple.provenance, so its disk image would carry them (#333).
       mise's binary usually does it, and macOS keeps tracking that file even once its attribute is
       removed, so replace it with a fresh copy without attributes, in a plain shell:
         R=\"\$(readlink -f \"\$(command -v mise)\")\" && cp -X \"\$R\" \"\$R.new\" && mv -f \"\$R.new\" \"\$R\"
       and release again (again after each Homebrew update of mise), or set SKIP_DMG=\"<why>\" for the zip alone."
    fi
fi

if [ "$DRY_RUN" != 1 ]; then
    git merge-base --is-ancestor "$COMMIT" "$MAIN" \
        || fail "a release builds origin/main or an earlier commit of it; $(git rev-parse --short "$COMMIT") isn't on main"
    # Being only behind origin/main, as after a release pushed its version bump, is fine.
    git diff --quiet "$COMMIT" -- Version.xcconfig \
        || git diff --quiet "$(git merge-base HEAD "$COMMIT")" -- Version.xcconfig \
        || fail "Version.xcconfig has changes that aren't on origin/main, which is what gets released; push them first"
    if released "$VERSION"; then
        fail "$TAG already exists; set MARKETING_VERSION in Version.xcconfig to an unreleased version and push it"
    fi
    xcrun notarytool history --keychain-profile "$NOTARY_PROFILE" >/dev/null 2>&1 \
        || fail "no notarytool keychain profile '$NOTARY_PROFILE' (see README: Releasing)"
    gh auth status >/dev/null 2>&1 || fail "gh is not signed in"
fi

# The regression suite (ARC-07) runs before the release is approved, not here: its release tier on
# this checkout at this commit, with the scenarios that need the app in front taking focus while the
# Mac is left alone. The release takes that run's passing report, or one for the commit before a
# version bump that changes nothing else, as when a release that pushed its bump is run again.
# SKIP_E2E="<why>" skips it and the black-box check, and the reason goes in the log.
# mise run release-checks runs the release tier, then every test suite, on the build Mac when it
# answers (ARC-15).
E2E_TIER="${E2E_TIER:-release}"
if [ "$E2E_TIER" = release ]; then
    E2E_RUN="mise run release-checks"
else
    E2E_RUN="mise run e2e -- --tier $E2E_TIER --focus"
fi
E2E_COMMITS=("$SOURCE")
if git rev-parse -q --verify "$SOURCE^" >/dev/null \
    && git diff --quiet "$SOURCE^" "$SOURCE" -- . ':(exclude)Version.xcconfig'; then
    E2E_COMMITS+=("$(git rev-parse "$SOURCE^")")
fi
if [ -n "${SKIP_E2E:-}" ]; then
    echo "==> Regression suite skipped: $SKIP_E2E"
elif REPORT="$(scripts/e2e.py --passing-report "${E2E_COMMITS[@]}" --tier "$E2E_TIER" --focus)"; then
    echo "==> Regression suite: a passing $E2E_TIER run with focus, $REPORT"
elif [ "$DRY_RUN" = 1 ]; then
    echo "==> Regression suite: no passing $E2E_TIER run with focus for $(git rev-parse --short "$SOURCE"), which a release needs ($E2E_RUN)"
else
    fail "no passing $E2E_TIER run of the regression suite with focus for $(git rev-parse --short "$SOURCE").
       Run it before approving the release, in this checkout at that commit, and leave the Mac it runs
       on alone while it takes focus: $E2E_RUN"
fi

rm -rf "$OUT"
mkdir -p "$OUT"
WORK="$(mktemp -d)"
SRC="$WORK/redlamp"
trap 'rm -rf "$WORK"; git worktree prune' EXIT
git worktree add --quiet --detach "$SRC" "$COMMIT"
if [ "$BUMP" = 1 ]; then
    git show "$COMMIT:Version.xcconfig" \
        | sed -E "s/^(MARKETING_VERSION *= *)[^ ]+/\1$VERSION/" >"$SRC/Version.xcconfig"
    git -C "$SRC" commit --quiet -m "Version $VERSION" -- Version.xcconfig
    COMMIT="$(git -C "$SRC" rev-parse HEAD)"
    if [ "$DRY_RUN" != 1 ] && [ "$SOURCE" = "$MAIN" ]; then
        echo "==> Pushing Version $VERSION to main..."
        git -C "$SRC" push --quiet origin HEAD:refs/heads/main \
            || fail "couldn't push Version $VERSION to main; if main moved on, run the release again"
    elif [ "$DRY_RUN" != 1 ]; then
        # The tag keeps the release's own bump; main takes the version on top of what it has.
        BUMPED="$WORK/main"
        git worktree add --quiet --detach "$BUMPED" "$MAIN"
        sed -E "s/^(MARKETING_VERSION *= *)[^ ]+/\1$VERSION/" "$BUMPED/Version.xcconfig" >"$WORK/Version.xcconfig"
        mv "$WORK/Version.xcconfig" "$BUMPED/Version.xcconfig"
        if ! git -C "$BUMPED" diff --quiet -- Version.xcconfig; then
            echo "==> Pushing Version $VERSION to main, which goes on past $(git rev-parse --short "$SOURCE")..."
            git -C "$BUMPED" commit --quiet -m "Version $VERSION" -- Version.xcconfig
            git -C "$BUMPED" push --quiet origin HEAD:refs/heads/main \
                || fail "couldn't push Version $VERSION to main; if main moved on, run the release again"
        fi
    fi
fi
BUILD="$(git rev-list --count "$COMMIT")"
echo "==> Releasing Redlamp $VERSION (build $BUILD) from ${REF:-origin/main}: $(git log -1 --format='%h %s' "$COMMIT")"
# Reusing the vendored LibRaw and libjxl saves rebuilds; generate still rebuilds either if its stamp
# doesn't match its pins (and LibRaw's shim).
for framework in LibRaw libjxl; do
    [ ! -d "vendor/build/$framework.xcframework" ] \
        || ditto "vendor/build/$framework.xcframework" "$SRC/vendor/build/$framework.xcframework"
done
FIRMWARE_MODEL=0
if [ -n "${SKIP_FIRMWARE_MODEL:-}" ]; then
    echo "==> Firmware model skipped: $SKIP_FIRMWARE_MODEL"
elif [ ! -f "$SRC/scripts/firmware-release-config.py" ]; then
    echo "==> Firmware model: $(git rev-parse --short "$COMMIT") predates it (TON-50)"
else
    # Into the throwaway worktree only, so neither the addresses nor the secret is ever committed.
    python3 "$SRC/scripts/firmware-release-config.py" "$FIRMWARE_CONFIG" "$SRC" \
        || fail "the firmware model config at $FIRMWARE_CONFIG isn't complete; see above"
    FIRMWARE_MODEL=1
fi
(cd "$SRC" && mise run generate)

# What ships is stripped of all but its exported symbols; the dSYMs keep the rest, for
# symbolicating crash reports.
for scheme in Redlamp redlamp; do
    echo "==> Building $scheme (Release, Developer ID)..."
    xcodebuild build \
        -workspace "$SRC/Redlamp.xcworkspace" \
        -scheme "$scheme" \
        -configuration Release \
        -destination 'platform=macOS,arch=arm64' \
        -derivedDataPath "$OUT/DerivedData" \
        CURRENT_PROJECT_VERSION="$BUILD" \
        REDLAMP_UPDATE_FEED="$FEED" \
        REDLAMP_DISTRIBUTION=developer-id \
        REDLAMP_COMMIT="$(git rev-parse --short=12 "$COMMIT")" \
        CODE_SIGN_STYLE=Manual \
        CODE_SIGN_IDENTITY="$IDENTITY" \
        CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
        ENABLE_HARDENED_RUNTIME=YES \
        OTHER_CODE_SIGN_FLAGS=--timestamp \
        DEPLOYMENT_POSTPROCESSING=YES \
        STRIP_STYLE=non-global \
        -quiet
done

# The CLI ships inside the app so it shares the app's frameworks (its rpath includes
# @executable_path/../Frameworks). Helpers, not MacOS: `redlamp` and `Redlamp` collide
# on a case-insensitive volume.
echo "==> Assembling $APP..."
ditto "$PRODUCTS/Redlamp.app" "$APP"
mkdir -p "$APP/Contents/Helpers"
ditto "$PRODUCTS/redlamp" "$APP/Contents/Helpers/redlamp"
# Sparkle ships its helpers ad-hoc signed, and Code Sign on Copy re-signs only the framework,
# so they're signed here, inside out. Its XPC services are only for sandboxed apps.
SPARKLE="$APP/Contents/Frameworks/Sparkle.framework"
rm -rf "$SPARKLE/XPCServices" "$SPARKLE/Versions/B/XPCServices"
# Unless the app allows mixed localizations, Sparkle shows only the languages the app has, so
# the rest go.
if ! /usr/libexec/PlistBuddy -c "Print :CFBundleAllowMixedLocalizations" "$APP/Contents/Info.plist" >/dev/null 2>&1; then
    for localization in "$SPARKLE"/Versions/B/Resources/*.lproj; do
        name="$(basename "$localization")"
        [ "$name" = Base.lproj ] || [ -d "$APP/Contents/Resources/$name" ] || rm -rf "$localization"
    done
fi
# Sparkle's binaries come universal; Redlamp runs on Apple Silicon only.
for binary in "$SPARKLE/Versions/B/Autoupdate" "$SPARKLE/Versions/B/Updater.app/Contents/MacOS/Updater" \
    "$SPARKLE/Versions/B/Sparkle"; do
    [ "$(lipo -archs "$binary")" = arm64 ] || lipo "$binary" -thin arm64 -output "$binary"
done
for code in "$SPARKLE/Versions/B/Autoupdate" "$SPARKLE/Versions/B/Updater.app" "$SPARKLE"; do
    codesign --force --options runtime --timestamp --sign "$IDENTITY" "$code"
done
codesign --force --options runtime --timestamp \
    --preserve-metadata=entitlements,requirements,flags \
    --sign "$IDENTITY" "$APP"
codesign --verify --deep --strict "$APP"
# Each release's dSYMs go up with it, beside the zip, since the next run deletes $OUT.
mkdir -p "$DSYMS"
cp -R "$PRODUCTS"/*.dSYM "$DSYMS/"
ditto -c -k --keepParent "$DSYMS" "$DSYMS_ZIP"
scripts/check-release-bundle.sh "$APP" "$DSYMS" || fail "the app isn't shaped for release; see above"
# With no arguments the CLI prints its usage and exits 1; dyld failures print something else.
CLI_STATUS=0
CLI_OUTPUT="$("$APP/Contents/Helpers/redlamp" 2>&1)" || CLI_STATUS=$?
grep -q 'usage: redlamp' <<<"$CLI_OUTPUT" \
    || fail "the bundled CLI does not run (exit status $CLI_STATUS): ${CLI_OUTPUT:-no output}"
# Both hosted addresses reached the app whole (a `//` the xcconfig read as a comment leaves "https:"),
# and what they hold opens with the kept config's secret for this team, fetched with curl, which goes
# through a proxy where the CLI's URLSession doesn't.
if [ "$FIRMWARE_MODEL" = 1 ]; then
    FIRMWARE_FILES="$WORK/firmware"
    mkdir -p "$FIRMWARE_FILES"
    for key in RedlampFirmwareTablesURL RedlampFirmwareKeyURL; do
        VALUE="$(/usr/libexec/PlistBuddy -c "Print :$key" "$APP/Contents/Info.plist" 2>/dev/null || true)"
        [[ "$VALUE" =~ ^https://[^/]+/ ]] || fail "the app's $key isn't a whole https address; check $FIRMWARE_CONFIG"
        curl -fsS --max-time 60 -o "$FIRMWARE_FILES/$key" "$VALUE" \
            || fail "couldn't fetch the hosted file at the app's $key"
    done
    "$APP/Contents/Helpers/redlamp" recipe firmware-pack --check --config "$FIRMWARE_CONFIG" --team "$TEAM_ID" \
        --tables-file "$FIRMWARE_FILES/RedlampFirmwareTablesURL" --key-file "$FIRMWARE_FILES/RedlampFirmwareKeyURL" \
        || fail "the hosted firmware model doesn't open with the secret in $FIRMWARE_CONFIG; host the files it was sealed with"
fi

# The signed app as a black box (ARC-07); E2E_NO_UPDATE=1 leaves out the Sparkle update check.
if [ -z "${SKIP_E2E:-}" ]; then
    echo "==> Checking the signed app as a black box..."
    REDLAMP_SIGN_IDENTITY="$IDENTITY" scripts/e2e.py --blackbox "$APP" ${E2E_NO_UPDATE:+--no-update} \
        || fail "the signed app failed its black-box checks"
fi

# The zip leaves out the extended attributes the build gave the app's files: Finder puts them back
# when it unpacks a download, and Gatekeeper on macOS 26 then refuses to open the app.
zip_app() {
    ditto -c -k --norsrc --noextattr --noacl --keepParent "$APP" "$ZIP"
    scripts/check-release-zip.sh "$ZIP" ${1:+"$1"} || fail "the zip doesn't unpack to the app as it was signed; see above"
}

# redlamp.app's download button offers the disk image, the app beside a link to /Applications;
# updates and Homebrew take the zip. Making and checking the image mounts it, which the agent's
# sandbox refuses: SKIP_DMG="<why>" leaves it out, and the button offers the zip.
dmg_app() {
    if [ -n "${SKIP_DMG:-}" ]; then
        echo "==> Disk image skipped: $SKIP_DMG"
        return
    fi
    scripts/release-dmg.sh "$APP" "$DMG" || fail "couldn't make the disk image; see above"
    codesign --force --timestamp --sign "$IDENTITY" "$DMG"
    [ -z "${1:-}" ] || mise run notarize -- "$DMG"
    scripts/check-release-dmg.sh "$DMG" ${1:+"$1"} || fail "the disk image doesn't hold the app as it was signed; see above"
}

# The release's highlights, chosen in the release room, then its commits, or the comparison's link
# when they won't fit in a GitHub release (scripts/release-notes.sh). The highlights are main's: a
# release from an earlier commit is often chosen after its highlights were. A dry run makes them too.
git fetch --quiet --tags origin
NOTES="$OUT/notes.md"
scripts/release-notes.sh "$VERSION" "$COMMIT" "$MAIN" >"$NOTES"
# A release made from an earlier commit isn't on main, so the previous release is the latest tagged.
PREVIOUS="$(git for-each-ref --sort=-creatordate --format='%(refname:short)' 'refs/tags/v*' \
    | awk -v tag="$TAG" '$0 != tag { print; exit }')"

if [ "$DRY_RUN" = 1 ]; then
    zip_app
    dmg_app
    MADE="$ZIP"
    [ -n "${SKIP_DMG:-}" ] || MADE="$ZIP and $DMG"
    echo "==> Dry run: signed but not notarized: $MADE (mise run notarize -- $APP to notarize it), dSYMs $DSYMS_ZIP, notes $NOTES"
    exit 0
fi

# Installed copies trust only the app's public key, so the zip must be signed with its pair.
SPARKLE_BIN="$SRC/Tuist/.build/artifacts/sparkle/Sparkle/bin"
KEY="$("$SPARKLE_BIN/generate_keys" --account redlamp -p)" \
    || fail "no Sparkle signing key for account 'redlamp' in the keychain (see README: Releasing)"
[ "$KEY" = "$(/usr/libexec/PlistBuddy -c 'Print :SUPublicEDKey' "$APP/Contents/Info.plist")" ] \
    || fail "the keychain's Sparkle key isn't the app's SUPublicEDKey"

mise run notarize -- "$APP"

# The zip and the disk image are made after stapling, so the app in each carries its ticket and
# opens offline.
zip_app --notarized
dmg_app --notarized

"$SRC/scripts/appcast.sh" "$APP" "$ZIP" \
    "https://github.com/pdcgomes/redlamp/releases/download/$TAG/$(basename "$ZIP")" "$NOTES" >"$OUT/appcast.xml"
xmllint --noout "$OUT/appcast.xml"

echo "==> Publishing $TAG..."
git tag -a "$TAG" "$COMMIT" -m "Redlamp $VERSION"
git push origin "$TAG"
# redlamp.app's download button, the Homebrew cask and the update feed follow the release marked Latest.
ASSETS=("$ZIP" "$DSYMS_ZIP" "$OUT/appcast.xml")
[ -n "${SKIP_DMG:-}" ] || ASSETS+=("$DMG")
# GitHub's generated notes are only its changelog link, since nothing lands through pull requests.
# Left to find the previous release itself, it passes over those tagged off main.
gh release create "$TAG" "${ASSETS[@]}" --verify-tag --latest --title "Redlamp $VERSION" \
    --notes-file "$NOTES" --generate-notes --notes-start-tag "$PREVIOUS"

for _ in 1 2 3 4 5 6; do
    if grep -q "<sparkle:version>$BUILD</sparkle:version>" <<<"$(curl -fsSL "$FEED" 2>/dev/null || true)"; then
        echo "==> Released $TAG, and $FEED offers it. The Update cask workflow points Casks/redlamp.rb at it."
        exit 0
    fi
    sleep 10
done
fail "released $TAG, but $FEED doesn't offer build $BUILD; check the redirect in web/next.config.ts"
